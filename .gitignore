# Huge data/model workspaces — separate efforts, not part of the thesis repo
QIP/
Youtube Model/
.venv/

# Copyrighted / re-downloadable reading material
Books/
MoE papers/

# Downloaded data caches (re-fetchable; the code is the interface, not the cache)
data_cache/

# Model artifacts and pickles (OP model/lgbm outputs etc.)
**/artifacts/
*.pkl

# Python / OS noise
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# LaTeX build artifacts (NEC_textbook)
NEC_textbook/*.log
NEC_textbook/*.aux
NEC_textbook/*.toc
NEC_textbook/*.out

# Other workspaces: code is tracked, derived data is not
Trexquant/cache/
Trexquant/panel/
MLFB/

# Licensed CRSP / Compustat data: redistribution prohibited by the CRSP Data Media Agreement.
# Never commit anything in this folder.
Data/

# Run store (brief 07 B): resume state and logs are local, never committed.
# Everything else under results/ is aggregate output and stays trackable.
nec_baseline/results/**/checkpoints/
nec_baseline/results/**/logs/
